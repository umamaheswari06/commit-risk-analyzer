# Copy this file to .env (or export these as real environment variables)
# and fill in your own values. Never commit a real .env file.

# --- Active profile ---
# "dev"   -> in-memory H2 database, zero setup (default)
# "mysql" -> real MySQL database, see values below
SPRING_PROFILES_ACTIVE=dev

# --- MySQL (only needed when SPRING_PROFILES_ACTIVE=mysql) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=commit_risk_analyzer
DB_USERNAME=root
DB_PASSWORD=

# --- AI provider ---
# If AI_API_KEY is left empty, the app automatically uses the rule-based
# fallback explanation generator - the app still works end-to-end.
AI_ENABLED=true
AI_PROVIDER=anthropic
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-4-6

# --- Server ---
SERVER_PORT=8080
